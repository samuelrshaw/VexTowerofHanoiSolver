{"mode":"Text","hardwareTarget":"brain","textContent":"#pragma region VEXcode Generated Robot Configuration\n// Make sure all required headers are included.\n#include <stdio.h>\n#include <stdlib.h>\n#include <stdbool.h>\n#include <math.h>\n#include <string.h>\n\n\n#include \"vex.h\"\n\nusing namespace vex;\n\n// Brain should be defined by default\nbrain Brain;\n\n\n// START IQ MACROS\n#define waitUntil(condition)                                                   \\\n  do {                                                                         \\\n    wait(5, msec);                                                             \\\n  } while (!(condition))\n\n#define repeat(iterations)                                                     \\\n  for (int iterator = 0; iterator < iterations; iterator++)\n// END IQ MACROS\n\n\n// Robot configuration code.\ninertial BrainInertial = inertial();\nmotor Motor9 = motor(PORT9, false);\nmotor Motor6 = motor(PORT6, false);\nmotor Motor1 = motor(PORT1, false);\ncontroller Controller = controller();\ntouchled TouchLED5 = touchled(PORT5);\noptical Optical3 = optical(PORT3);\nbumper Bumper4 = bumper(PORT4);\n\n\n// generating and setting random seed\nvoid initializeRandomSeed(){\n  wait(100,msec);\n  double xAxis = BrainInertial.acceleration(xaxis) * 1000;\n  double yAxis = BrainInertial.acceleration(yaxis) * 1000;\n  double zAxis = BrainInertial.acceleration(zaxis) * 1000;\n  // Combine these values into a single integer\n  int seed = int(\n    xAxis + yAxis + zAxis\n  );\n  // Set the seed\n  srand(seed); \n}\n\n// Converts a color to a string\nconst char* convertColorToString(color col) {\n  if (col == colorType::red) return \"red\";\n  else if (col == colorType::green) return \"green\";\n  else if (col == colorType::blue) return \"blue\";\n  else if (col == colorType::white) return \"white\";\n  else if (col == colorType::yellow) return \"yellow\";\n  else if (col == colorType::orange) return \"orange\";\n  else if (col == colorType::purple) return \"purple\";\n  else if (col == colorType::cyan) return \"cyan\";\n  else if (col == colorType::black) return \"black\";\n  else if (col == colorType::transparent) return \"transparent\";\n  else if (col == colorType::red_violet) return \"red_violet\";\n  else if (col == colorType::violet) return \"violet\";\n  else if (col == colorType::blue_violet) return \"blue_violet\";\n  else if (col == colorType::blue_green) return \"blue_green\";\n  else if (col == colorType::yellow_green) return \"yellow_green\";\n  else if (col == colorType::yellow_orange) return \"yellow_orange\";\n  else if (col == colorType::red_orange) return \"red_orange\";\n  else if (col == colorType::none) return \"none\";\n  else return \"unknown\";\n}\n\n\n// Convert colorType to string\nconst char* convertColorToString(colorType col) {\n  if (col == colorType::red) return \"red\";\n  else if (col == colorType::green) return \"green\";\n  else if (col == colorType::blue) return \"blue\";\n  else if (col == colorType::white) return \"white\";\n  else if (col == colorType::yellow) return \"yellow\";\n  else if (col == colorType::orange) return \"orange\";\n  else if (col == colorType::purple) return \"purple\";\n  else if (col == colorType::cyan) return \"cyan\";\n  else if (col == colorType::black) return \"black\";\n  else if (col == colorType::transparent) return \"transparent\";\n  else if (col == colorType::red_violet) return \"red_violet\";\n  else if (col == colorType::violet) return \"violet\";\n  else if (col == colorType::blue_violet) return \"blue_violet\";\n  else if (col == colorType::blue_green) return \"blue_green\";\n  else if (col == colorType::yellow_green) return \"yellow_green\";\n  else if (col == colorType::yellow_orange) return \"yellow_orange\";\n  else if (col == colorType::red_orange) return \"red_orange\";\n  else if (col == colorType::none) return \"none\";\n  else return \"unknown\";\n}\n\n\nvoid vexcodeInit() {\n\n  // Initializing random seed.\n  initializeRandomSeed(); \n}\n\n\n// define variable for remote controller enable/disable\nbool RemoteControlCodeEnabled = true;\n\n#pragma endregion VEXcode Generated Robot Configuration\n\n//----------------------------------------------------------------------------\n//                                                                            \n//    Module:       main.cpp                                                  \n//    Author:       {author}                                                  \n//    Created:      {date}                                                    \n//    Description:  IQ project                                                \n//                                                                            \n//----------------------------------------------------------------------------\n\n// Include the IQ Library\n#include \"iq_cpp.h\"\n\n// Allows for easier use of the VEX Library\nusing namespace vex;\n\n\n#include \"vex.h\"\nusing namespace vex;\n\nconst double GRIP_HEIGHTS[4] = {0, -780, -670, -598};\nconst double DROP_HEIGHT = -500;\nconst int MIN_HUES[4] = {0, 200, 300, 0};\nconst int MAX_HUES[4] = {0, 270, 340, 20};\n\n\n\n//the main brain of the program, it will call on the moves throughout\nvoid abovePeg (int currentPeg, int newPeg){\n\n  int minHue; //minimum hue for colour to be confirmed\n  int maxHue; //maximum hue for colour to be confirmed\n\n  if (newPeg == 1){ //corresponds to blue\n    minHue = MIN_HUES[1];\n    maxHue = MAX_HUES[1]; \n  } else if (newPeg == 2){ //corresponds to purple\n    minHue = MIN_HUES[2]; \n    maxHue = MAX_HUES[2]; \n  } else if (newPeg == 3) { //corresponds to pink\n    minHue = MIN_HUES[3]; \n    maxHue = MAX_HUES[3]; \n  }\n\n  if (currentPeg < newPeg){\n    Motor6.spin(forward, 10, percent); \n  } else {\n    Motor6.spin(reverse, 10, percent); \n  }\n\n  while (Optical3.hue()<minHue || Optical3.hue()>maxHue){}\n\n  Motor6.stop(brake); \n}\n\n\n\n\n/*Raises the ring by waiting till the bumper sensor hits the top*/\nvoid raiseRing(){\n  Motor9.spin(forward, 10, percent); \n  while (!Bumper4.pressing()){\n  }\n\n  Motor9.setPosition(0, degrees);\n  Motor9.stop(brake); \n  \n}\n\n/*grips the ring by letting the motor run for a set amount of time*/\nvoid gripRing(){\n  timer time1;\n  time1.clear(); \n\n  Motor1.setMaxTorque(60, percent);\n  Motor1.spin(forward, 10, percent);\n  while (time1.time(seconds) < 5){}\n}\n\n\n/*descends to ring given a set amount of times recevied from the array containing the motor encoder degrees corresponding to each ring*/\nvoid descendToRing(double targetDegrees) {\n    Motor9.spinToPosition(targetDegrees, degrees);\n    Motor9.stop(hold);\n    }\n\n/*can probably be fused with the calibrate robot function that will be specified as startup*/\nvoid waitForTouch() {\n    TouchLED5.setColor(blue);\n    while (!TouchLED5.pressing()) {\n    }\n\n    while (TouchLED5.pressing()) {\n    }\n    TouchLED5.setColor(red);}\n\n\n\n\n/*this will be called on by the recursive hanoi function to move a disk from a starting peg to the destination peg*/\n\nvoid openClaw(){\n  Motor1.spin(reverse, 20, percent); \n  wait(2, seconds); \n  Motor1.stop(brake);\n}\n\n\n\n/*moves the claw from one peg to the next peg*/\nbool moveDisk(int startPeg, int destinationPeg, int &currentPeg, int diskCount[], int &movesCompleted){\n\n  //add feature where it \"scrolls\" on the brain screen as it goes through the moves\n\n  int ringPicked = diskCount[startPeg]; //this corresponds to the ring being picked\n\n  //start each move with the lift homed and the claw open which startup establishes for move 1\n  if (currentPeg != startPeg){\n    abovePeg(currentPeg, startPeg); \n    currentPeg = startPeg; \n  }\n\n  //pick up the topmost ring and lift it clear of all the rods\n  descendToRing(GRIP_HEIGHTS[ringPicked]);\n  gripRing(); \n  raiseRing();\n\n  //Carry the ring to the destination and drop it from the fixed height\n  abovePeg(currentPeg, destinationPeg); \n  currentPeg = destinationPeg; \n  descendToRing(DROP_HEIGHT);\n\n  openClaw(); \n\n  diskCount[startPeg]--;\n  diskCount[destinationPeg]++;\n\n  raiseRing(); \n  movesCompleted++;\n\n  Brain.Screen.print(\"Move %d: %d -> %d\", movesCompleted, startPeg, destinationPeg);\n  Brain.Screen.newLine(); //right now, the last line once the brain screen is filled gets overwritten, a \"scroll like feature\" should be added\n  wait(2, seconds);\n  return true; \n}\n/*this will be changed to the startup function where it homes itself onto peg 1 or the starting peg\n1. Operator stacks three disks on peg 1, largest at the bottom\n2. Optical sensor light turns on and the screen shows “Homing”\n3. Lift rises until the bumper presses, then its encoder is zeroed\n4. Gantry finds peg 1 by colour and the touch LED glows green\n5. Operator presses touch, the LED turns red (to signify being able to stop) and the run begins\n*/\nbool recursiveHanoi(int numDisks, int startPeg, int otherPeg, int destinationPeg, int &currentPeg, int diskCount[], int &movesCompleted){\n  if (numDisks == 0){\n    //base case\n    return true; \n  } else {\n    /*recursively calls the function itself; ignores the largest ring seated on the bottom of the peg, and solves the tower of hanoi\n    for the remaining n-1 rings, relocating them from the startPeg to the otherPeg*/\n\n    if (!recursiveHanoi(numDisks - 1, startPeg, destinationPeg, otherPeg, currentPeg, diskCount, movesCompleted)){\n      return false; \n    }\n\n    //moves the largest ring from where it is on the startPeg to the finalPeg \n    if (!moveDisk(startPeg, destinationPeg, currentPeg, diskCount, movesCompleted)){\n      return false; \n    }\n    /*recursively calls again to solve the tower of hanoi again (rings arranged on the middle peg, and then needs to be relocation to destination peg) */\n    return recursiveHanoi (numDisks - 1, otherPeg, startPeg, destinationPeg, currentPeg, diskCount, movesCompleted);\n  }\n}\nvoid startUp(){\n  waitForTouch(); \n  Optical3.setLight(ledState::on);\n  wait (50, msec); \n  raiseRing(); \n  openClaw(); \n\n  /*add an abovePeg function with a niche case (going from current peg = 0 to peg 1);*/\n }\n\n\n/*shutdown procedure which will carry out when touch sensor is hit, and receives bool parameters of carrying ring or finished\n\nIf the puzzle is cleared this will follow:\n1. The last move leaves all three disks on peg 3\n2. Lift returns home and the claw opens\n3. Screen shows the moves made and the elapsed time\n4. Touch LED turns green and every motor stops\n5. main returns, so the program ends on its own without the abort button\n\nelse if it is gripping a ring, or the puzzle is not finishied and the red touch led is not hit\n1. lift returns to home and drops the remaining ring\n2. screen shows moves made and in all caps, program ended early\n3. Every motor stops, main return\n*/\n\n\nvoid shutdownFunction(){\n  //\n}\n\nint main() {\n  Brain.Screen.clearScreen(); \n  Brain.Screen.setCursor(1, 1); \n  \n  startUp(); \n\n  int numDisks = 3; \n  int startPeg = 1; \n  int currentPeg = startPeg;\n  int otherPeg = 2; \n  int destinationPeg = 3; \n  int diskCount[4] = {0, 3, 0, 0}; //index 0 is useless, 3 is number of rings on startPeg, 0 on otherPeg, and 0 on finalPeg - should be generalized after\n\n  \n  int movesCompleted = 0; \n\n  bool completed = recursiveHanoi (numDisks, startPeg, otherPeg, destinationPeg, currentPeg, diskCount, movesCompleted);\n\n}\n\n/*finding motor encoder values -  raiseRing();\n  Motor9.setPosition(0, degrees); \n  \n  //top of the peg (needed for drop off ring), ring 1, ring 2, ring 3 in descending order); \n\n  abovePeg(1, 2);\n  //corresponds to upper and lower ranges of the colours checked\n  \n  // Position the claw above the test peg before starting.\n  waitForTouch();\n\n  for (int i = 0; i < 3; i++) {\n    raiseRing();  // Homes and resets Motor9 to zero.\n        descendToRing(testHeights[i]);\n        Brain.Screen.clearScreen();\n        Brain.Screen.setCursor(1, 1);\n        Brain.Screen.print(\"Target: %.1f\", testHeights[i]);\n        Brain.Screen.setCursor(2, 1);\n        Brain.Screen.print(\"Actual: %.1f\",\n                           Motor9.position(degrees));\n        gripRing(); \n        raiseRing(); \n        Motor1.setMaxTorque(0, percent);\n        Motor1.stop(brake);\n        Motor1.spin(reverse, 20, percent);\n        // Inspect the height, then press touch to continue.\n        waitForTouch();\n    }\n\n    raiseRing();\n\n    // Keep the program active with the lift holding.\n    while (true) {\n        wait(100, msec);\n    }\n  */","textLanguage":"cpp","robotConfig":[{"port":[9],"name":"Motor9","customName":false,"deviceType":"Motor","deviceClass":"motor","setting":{"reversed":"false","fwd":"forward","rev":"reverse"},"triportSourcePort":22},{"port":[6],"name":"Motor6","customName":false,"deviceType":"Motor","deviceClass":"motor","setting":{"reversed":"false","fwd":"forward","rev":"reverse"},"triportSourcePort":22},{"port":[1],"name":"Motor1","customName":false,"deviceType":"Motor","deviceClass":"motor","setting":{"reversed":"false","fwd":"forward","rev":"reverse"},"triportSourcePort":22},{"port":[],"name":"Controller","customName":false,"deviceType":"Controller","deviceClass":"controller","setting":{"left":"","leftDir":"false","right":"","rightDir":"false","e":"","eDir":"false","f":"","fDir":"false","l3r3":"","l3r3Dir":"false","drive":"none"},"triportSourcePort":22},{"port":[5],"name":"TouchLED5","customName":false,"deviceType":"TouchLED","deviceClass":"touchled","setting":{},"triportSourcePort":22},{"port":[3],"name":"Optical3","customName":false,"deviceType":"Optical","deviceClass":"optical","setting":{},"triportSourcePort":22},{"port":[4],"name":"Bumper4","customName":false,"deviceType":"Bumper","deviceClass":"bumper","setting":{},"triportSourcePort":22}],"slot":0,"platform":"IQ","sdkVersion":"20230818.11.00.00","appVersion":"4.68.1","fileFormat":"2.0.0","targetBrainGen":"Second","v5SoundsEnabled":false,"aiVisionSettings":{"colors":[],"codes":[],"tags":true,"AIObjects":true,"AIObjectModel":[],"aiModelDropDownValue":null}}